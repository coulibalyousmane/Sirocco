<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Premier protocole de reference de la roadmap phase 6 (SQL, avant SSE/MQTT/GraphQL) : valide le
    contrat de plugin (voir tools/../samples/Sirocco.SamplePlugin) contre un protocole reellement
    different de HTTP, pas une variation de plus autour d'IVirtualUserContext.HttpClient. Seule
    dependance au-dela de Sirocco.Domain : le pilote SQLite lui-meme — aucun serveur externe requis,
    ce qui garde la verification end-to-end reproductible sans infrastructure supplementaire.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Sirocco.Domain\Sirocco.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

</Project>
