<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Troisieme protocole de reference de la roadmap phase 6 (MQTT, apres SQL et SSE, avant GraphQL) :
    revient a un protocole reellement different de HTTP comme SQL, mais oriente publication/abonnement
    plutot que requete/reponse — un utilisateur virtuel publie sur un sujet puis attend sa propre
    reception via un abonnement, round-trip complet mesure par StepScope. Seule dependance au-dela de
    Sirocco.Domain : le client MQTTnet lui-meme, aucun serveur externe requis pour la verification
    end-to-end (voir samples/Sirocco.SampleTarget, qui heberge son propre broker embarque).
  -->
  <!--
    Publiee comme extension de reference (ROADMAP.md, ligne "Ecosysteme d'extensions
    communautaire") : sans une seule extension publiee, la convention d'ecriture d'extension n'a
    aucun exemple consommable a copier. C'est aussi le cas qui prouve la resolution transitive du
    26 aout 2026 : sa dependance MQTTnet est restauree par l'option plugin-package de la CLI, ce
    qui etait impossible avant. L'etiquette sirocco-extension est la convention de decouverte, pas un
    adoubement — voir docs/extensions/contrat.md.
  -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Sirocco.Extensions.Mqtt</PackageId>
    <Description>Extension Sirocco pour MQTT : publication puis reception du meme message via abonnement, round-trip complet chronometre. Dependance managee MQTTnet, aucun composant natif.</Description>
    <PackageTags>load-testing;performance;sirocco-extension;mqtt;iot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sirocco.Domain\Sirocco.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
  </ItemGroup>

</Project>
