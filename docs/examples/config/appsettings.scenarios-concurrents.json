{
  "Sirocco": {
    "TargetBaseUrl": "http://localhost:5281",
    "ExitAfterRun": true,
    "Scenarios": [
      {
        "Name": "checkout-open",
        "MaxVirtualUsers": 10,
        "Profile": [{ "FromRps": 20, "ToRps": 20, "DurationSeconds": 10 }],
        "ScenarioFile": "docs/examples/scenarios/checkout.yaml",
        "Thresholds": [
          { "StepName": "browse", "Metric": "ErrorRate", "Comparison": "LessThanOrEqual", "Limit": 0.0 },
          { "StepName": "__iteration", "Metric": "ErrorRate", "Comparison": "LessThanOrEqual", "Limit": 0.01 }
        ]
      },
      {
        "Name": "browse-closed",
        "MaxVirtualUsers": 5,
        "ClosedModelDuration": "00:00:10",
        "ScenarioFile": "docs/examples/scenarios/browse.yaml",
        "Thresholds": [
          { "StepName": "__iteration", "Metric": "ErrorRate", "Comparison": "LessThanOrEqual", "Limit": 0.01 }
        ]
      }
    ]
  }
}
