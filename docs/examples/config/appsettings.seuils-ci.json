{
  "Sirocco": {
    "TargetBaseUrl": "http://localhost:5281",
    "MaxVirtualUsers": 20,
    "ExitAfterRun": true,
    "Profile": [
      { "FromRps": 0, "ToRps": 20, "DurationSeconds": 5 },
      { "FromRps": 20, "ToRps": 20, "DurationSeconds": 10 },
      { "FromRps": 20, "ToRps": 0, "DurationSeconds": 3 }
    ],
    "Thresholds": [
      { "StepName": "__iteration", "Metric": "ResponseP95Milliseconds", "Comparison": "LessThan", "Limit": 1000 },
      { "StepName": "__iteration", "Metric": "ErrorRate", "Comparison": "LessThanOrEqual", "Limit": 0.01 }
    ]
  }
}
