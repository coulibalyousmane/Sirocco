{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "build": {
    "content": [
      {
        "files": ["**/*.md", "toc.yml"],
        "exclude": [
          "_site/**",
          "examples/**",
          "articles/_*.md",
          "extensions/_*.md"
        ]
      }
    ],
    "output": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appName": "Sirocco",
      "_appTitle": "Sirocco",
      "_description": "Moteur de test de charge haute performance, asynchrone et cloud-native, en C# / .NET 10.",
      "_enableSearch": true,
      "_enableNewTab": true,
      "_gitContribute": {
        "repo": "https://github.com/coulibalyousmane/Sirocco",
        "branch": "main",
        "apiSpecFolder": "docs"
      },
      "_appFooter": "Sirocco — Apache License 2.0. Les exemples de cette documentation sont de vrais fichiers du dépôt, exécutés par la CI."
    }
  }
}
