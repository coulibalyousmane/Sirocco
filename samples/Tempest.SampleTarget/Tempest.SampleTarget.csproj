<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bogus" Version="35.6.5" />
    <PackageReference Include="Grpc.AspNetCore" Version="2.83.0" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Courtier MQTT embarque pour le protocole de reference MQTT (Tempest.Extensions.Mqtt) :
         aucune infrastructure externe a installer pour verifier ce chantier de bout en bout. -->
    <PackageReference Include="MQTTnet.Server" Version="5.2.0.1603" />
    <!-- Moteur GraphQL reel (pas une simulation par correspondance de chaine) pour le protocole
         de reference GraphQL (Tempest.Extensions.GraphQl) : juste le moteur d'execution, aucune
         integration ASP.NET supplementaire (le point d'ecoute HTTP est cable a la main, comme
         REST/WebSocket). -->
    <PackageReference Include="GraphQL" Version="8.8.4" />
    <PackageReference Include="GraphQL.SystemTextJson" Version="8.8.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Meme fichier .proto que Tempest.Scenarios : desaccord de contrat = erreur de
         compilation, pas un echec silencieux au premier appel. -->
    <Protobuf Include="..\..\protos\tempest_echo.proto" GrpcServices="Server" Link="Protos\tempest_echo.proto" />
  </ItemGroup>

</Project>
