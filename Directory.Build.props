<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <Product>Sirocco</Product>
    <Authors>Sirocco</Authors>
    <Copyright>Copyright 2026 Ousmane Coulibaly</Copyright>
  </PropertyGroup>

  <!--
    Metadonnees NuGet communes a tous les paquets publiables du depot (Sirocco.Domain,
    Sirocco.Application, Sirocco.Infrastructure, Sirocco.Scenarios, Sirocco.Cli) : un seul
    endroit pour la licence, l'URL du depot et la version, plutot que quatre copies qui
    divergeraient tot ou tard. Sans effet sur les projets non publiables (IsPackable=false,
    comme Sirocco.Host ou les tests) : ces proprietes ne sont lues qu'au moment du pack.
  -->
  <PropertyGroup>
    <!--
      Publiable sur demande explicite seulement. Sans ce defaut, `dotnet pack Sirocco.sln`
      produisait 15 paquets au lieu de 5 : les 5 outils internes, les 4 extensions et
      Sirocco.SamplePlugin heritaient du IsPackable=true implicite du SDK. Un envoi sur nuget.org
      etant DEFINITIF (on masque un paquet, on ne le supprime jamais), le mode de defaillance doit
      etre "un paquet manque a l'appel", jamais "un identifiant est squatte pour toujours". Les
      cinq projets reellement publies posent donc IsPackable=true explicitement, et un projet
      ajoute plus tard ne partira pas tout seul.
    -->
    <IsPackable>false</IsPackable>
    <Version>0.1.0</Version>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/coulibalyousmane/Sirocco</PackageProjectUrl>
    <RepositoryUrl>https://github.com/coulibalyousmane/Sirocco</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!--
    Le chemin critique du moteur est "zero-allocation" : on veut que le JIT
    puisse inliner et vectoriser agressivement, et que les structs passees par
    'in' ne soient jamais copiees defensivement.
  -->
  <PropertyGroup>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

</Project>
