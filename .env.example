# Variables lues par docker-compose.yml. Copiez ce fichier en ".env" (ignore par git) et
# renseignez de vraies valeurs avant tout usage hors demo locale — jamais dans docker-compose.yml
# lui-meme, qui reste versionne.

# Secret partage du control plane maitre/worker (Sirocco__ClusterSharedSecret). Sans ce fichier,
# docker-compose.yml retombe sur une valeur de demonstration explicitement nommee pour ne pas
# etre reutilisee. 16 caracteres minimum (voir SECURITY.md).
SIROCCO_CLUSTER_SHARED_SECRET=
