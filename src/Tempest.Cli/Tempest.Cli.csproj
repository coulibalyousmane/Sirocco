<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Tempest.Host\Tempest.Host.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tempest.Cli</RootNamespace>
    <AssemblyName>tempest</AssemblyName>
    <!-- Une CLI n'est jamais hebergee sous IIS : web.config (bootstrap IIS/ANCM) n'a aucun sens
         a cote de tempest.exe. -->
    <IsWebConfigTransformDisabled>true</IsWebConfigTransformDisabled>
  </PropertyGroup>

  <!--
    Binaires autonomes (roadmap phase 1, troisieme bullet) : un "dotnet publish" self-contained,
    fichier unique, fonctionne pour Windows, Linux et macOS (x64 et arm64) sans qu'aucun RID ne
    soit declare ici — le SDK restaure a la demande ce dont cette seule invocation a besoin, y
    compris a travers Tempest.Host (ProjectReference). Deliberement pas de RuntimeIdentifiers
    permanent : le declarer casse le pack sans recompilation sur une arborescence propre (comme
    un runner CI) avec une erreur de manifeste static web assets par RID (fichier
    staticwebassets.build.json introuvable) : dotnet pack tente alors de produire, en plus du
    paquet outil portable, un paquet outil self-contained par RID, qui exigerait d'avoir
    prealablement publie (pas seulement construit) pour chacun. Ce bug a reellement casse la CI
    (commit a01498d) avant d'etre trouve et corrige ici.

    Pas de PublishAot non plus : YamlDotNet (DeserializerBuilder par defaut) et la
    deserialisation JSON par reflexion de ScenarioDefinitionLoader echouent a la compilation AOT
    (IL3050/IL2026) sans reecrire ce pipeline en code source-genere : chantier separe, plus
    risque, non traite ici.
  -->

  <!--
    Packaging dotnet tool (roadmap phase 1, deuxieme bullet) : dotnet pack produit un .nupkg
    installable en outil global (dotnet tool install, options globale et add source, vers
    Tempest.Cli), avec le nom de commande "tempest" plutot que le nom du paquet. Pas encore
    publie sur nuget.org : le depot reste prive (bullet suivant de la meme phase) ; ce paquet
    s'installe aujourd'hui depuis une source locale ou un flux prive.
  -->
  <PropertyGroup>
    <!-- Microsoft.NET.Sdk.Web desactive IsPackable par defaut (un site web ne se publie pas
         comme paquet NuGet) ; un outil dotnet, si. -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>tempest</ToolCommandName>
    <PackageId>Tempest.Cli</PackageId>
    <Description>CLI de Tempest, moteur de test de charge async cloud-native. "tempest run [scenario] [options]" lance un tir et se termine a la fin.</Description>
    <PackageTags>load-testing;performance;cli</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    Tempest.Host referme Tempest.Cli, et son appsettings*.json/web.config/staticwebassets sont
    marques CopyToOutputDirectory : sans ce nettoyage, un tempest.exe autonome se retrouverait
    avec l'appsettings.json de demonstration de l'hote a cote de lui, dans lequel Tempest:*
    contient de vraies valeurs (TargetBaseUrl inclus) : un "tempest run" lance sans preciser
    l'adresse de la cible y trouverait silencieusement une valeur qui n'est pas la bonne, plutot
    que l'erreur attendue. La CLI ne shippe deliberement aucun appsettings.json des siens : elle
    ne lit que celui, facultatif, du repertoire d'ou elle est lancee (voir Program.cs).
  -->
  <Target Name="RemoveInheritedWebHostFiles" AfterTargets="Build;Publish">
    <ItemGroup>
      <_TempestUnwantedOutputFiles Include="$(OutDir)appsettings.json" />
      <_TempestUnwantedOutputFiles Include="$(OutDir)appsettings.*.json" />
      <_TempestUnwantedOutputFiles Include="$(OutDir)web.config" />
      <_TempestUnwantedOutputFiles Include="$(OutDir)*.staticwebassets.endpoints.json" />
      <_TempestUnwantedOutputFiles Include="$(PublishDir)appsettings.json" Condition="'$(PublishDir)' != ''" />
      <_TempestUnwantedOutputFiles Include="$(PublishDir)appsettings.*.json" Condition="'$(PublishDir)' != ''" />
      <_TempestUnwantedOutputFiles Include="$(PublishDir)web.config" Condition="'$(PublishDir)' != ''" />
      <_TempestUnwantedOutputFiles Include="$(PublishDir)*.staticwebassets.endpoints.json" Condition="'$(PublishDir)' != ''" />
    </ItemGroup>
    <Delete Files="@(_TempestUnwantedOutputFiles)" />
  </Target>

</Project>
