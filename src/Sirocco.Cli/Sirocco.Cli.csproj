<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Sirocco.Host\Sirocco.Host.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Sirocco.Cli</RootNamespace>
    <AssemblyName>sirocco</AssemblyName>
    <!-- Une CLI n'est jamais hebergee sous IIS : web.config (bootstrap IIS/ANCM) n'a aucun sens
         a cote de sirocco.exe. -->
    <IsWebConfigTransformDisabled>true</IsWebConfigTransformDisabled>
  </PropertyGroup>

  <!--
    Binaires autonomes (roadmap phase 1, troisieme bullet) : un "dotnet publish" self-contained,
    fichier unique, fonctionne pour Windows, Linux et macOS (x64 et arm64) sans qu'aucun RID ne
    soit declare ici — le SDK restaure a la demande ce dont cette seule invocation a besoin, y
    compris a travers Sirocco.Host (ProjectReference). Deliberement pas de RuntimeIdentifiers
    permanent : le declarer casse le pack sans recompilation sur une arborescence propre (comme
    un runner CI) avec une erreur de manifeste static web assets par RID (fichier
    staticwebassets.build.json introuvable) : dotnet pack tente alors de produire, en plus du
    paquet outil portable, un paquet outil self-contained par RID, qui exigerait d'avoir
    prealablement publie (pas seulement construit) pour chacun. Ce bug a reellement casse la CI
    (commit a01498d) avant d'etre trouve et corrige ici.

    Pas de PublishAot non plus : YamlDotNet (DeserializerBuilder par defaut) et la
    deserialisation JSON par reflexion de ScenarioDefinitionLoader echouent a la compilation AOT
    (IL3050/IL2026) sans reecrire ce pipeline en code source-genere : chantier separe, plus
    risque, non traite ici.
  -->

  <!--
    Packaging dotnet tool (roadmap phase 1, deuxieme bullet) : dotnet pack produit un .nupkg
    installable en outil global (dotnet tool install, options globale et add source, vers
    Sirocco.Cli), avec le nom de commande "sirocco" plutot que le nom du paquet. Pas encore
    publie sur nuget.org : la publication est declenchee par un tag "vX.Y.Z" (release.yml), jamais
    pousse a ce jour ; ce paquet s'installe donc aujourd'hui depuis une source locale.

    Ce que les options de cette CLI et ses codes de sortie promettent a une CI tierce :
    docs/projet/versionnement.md, qui les place au meme niveau de contrat que l'API publique de
    Sirocco.Domain, car c'est d'eux que depend un pipeline, pas des types.
  -->
  <PropertyGroup>
    <!-- Microsoft.NET.Sdk.Web desactive IsPackable par defaut (un site web ne se publie pas
         comme paquet NuGet) ; un outil dotnet, si. -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sirocco</ToolCommandName>
    <PackageId>Sirocco.Cli</PackageId>
    <Description>CLI de Sirocco, moteur de test de charge async cloud-native. "sirocco run [scenario] [options]" lance un tir et se termine a la fin.</Description>
    <PackageTags>load-testing;performance;cli</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    Sirocco.Host referme Sirocco.Cli, et son appsettings*.json/web.config/staticwebassets sont
    marques CopyToOutputDirectory : sans ce nettoyage, un sirocco.exe autonome se retrouverait
    avec l'appsettings.json de demonstration de l'hote a cote de lui, dans lequel Sirocco:*
    contient de vraies valeurs (TargetBaseUrl inclus) : un "sirocco run" lance sans preciser
    l'adresse de la cible y trouverait silencieusement une valeur qui n'est pas la bonne, plutot
    que l'erreur attendue. La CLI ne shippe deliberement aucun appsettings.json des siens : elle
    ne lit que celui, facultatif, du repertoire d'ou elle est lancee (voir Program.cs).
  -->
  <Target Name="RemoveInheritedWebHostFiles" AfterTargets="Build;Publish">
    <ItemGroup>
      <_SiroccoUnwantedOutputFiles Include="$(OutDir)appsettings.json" />
      <_SiroccoUnwantedOutputFiles Include="$(OutDir)appsettings.*.json" />
      <_SiroccoUnwantedOutputFiles Include="$(OutDir)web.config" />
      <_SiroccoUnwantedOutputFiles Include="$(OutDir)*.staticwebassets.endpoints.json" />
      <_SiroccoUnwantedOutputFiles Include="$(PublishDir)appsettings.json" Condition="'$(PublishDir)' != ''" />
      <_SiroccoUnwantedOutputFiles Include="$(PublishDir)appsettings.*.json" Condition="'$(PublishDir)' != ''" />
      <_SiroccoUnwantedOutputFiles Include="$(PublishDir)web.config" Condition="'$(PublishDir)' != ''" />
      <_SiroccoUnwantedOutputFiles Include="$(PublishDir)*.staticwebassets.endpoints.json" Condition="'$(PublishDir)' != ''" />
    </ItemGroup>
    <Delete Files="@(_SiroccoUnwantedOutputFiles)" />
  </Target>

</Project>
