<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Tempest.Application\Tempest.Application.csproj" />
    <ProjectReference Include="..\Tempest.Infrastructure\Tempest.Infrastructure.csproj" />
    <ProjectReference Include="..\Tempest.Scenarios\Tempest.Scenarios.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.17.0-beta.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Requis pour que Tempest.Cli (voir son commentaire) puisse se publier self-contained :
         un Sdk.Web referme par un autre projet doit restaurer les memes RID que celui-ci, meme
         si Tempest.Host lui-meme n'est jamais publie self-contained. -->
    <RuntimeIdentifiers>$(TempestStandaloneRuntimeIdentifiers)</RuntimeIdentifiers>
  </PropertyGroup>

</Project>
