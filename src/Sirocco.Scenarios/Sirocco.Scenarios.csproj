<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Sirocco.Domain\Sirocco.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fichier unique partage avec Sirocco.SampleTarget : un desaccord de contrat echoue a la
         compilation, pas a l'execution. GrpcServices="Both" (pas seulement "Client") : le cote
         serveur genere ici sert de base au faux service gRPC de Sirocco.UnitTests — sans lui,
         regenerer les memes messages depuis Sirocco.UnitTests entrerait en conflit de type
         (CS0436) avec ceux deja references via ce projet. -->
    <Protobuf Include="..\..\protos\sirocco_echo.proto" GrpcServices="Both" Link="Protos\sirocco_echo.proto" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Bogus" Version="35.6.5" />
    <PackageReference Include="Google.Protobuf" Version="3.36.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.14.0" />
    <!-- Resolution NuGet d'un plugin (roadmap phase 6, deuxieme bullet) : client officiel plutot
         que reimplementer le protocole v3 (decouverte de version, telechargement de .nupkg). -->
    <PackageReference Include="NuGet.Protocol" Version="7.9.0" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Paquet NuGet bibliotheque (roadmap phase 1, dernier bullet) : scenarios de reference
       (DynamicCheckoutWorkflow, WebSocketEchoWorkflow, les quatre workflows gRPC) et le format
       declaratif (DeclarativeWorkflow, ScenarioDefinitionLoader, ExtractionRule) — reutilisables
       tels quels ou comme modele pour ecrire son propre IWorkflow. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Sirocco.Scenarios</PackageId>
    <Description>Scenarios de reference et format declaratif de Sirocco (DynamicCheckoutWorkflow, workflows gRPC/WebSocket, DeclarativeWorkflow) — a reutiliser ou comme modele pour ecrire son propre IWorkflow.</Description>
    <PackageTags>load-testing;performance</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
